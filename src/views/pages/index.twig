{#
| Variable         | Type       | Description                                                         |
|------------------|------------|---------------------------------------------------------------------|
| page             | object     |                                                                     |
| page.title       | string     | *could be html                                                      |
| page.slug        | string     | ex: "cat.show"                                                      |
#}
{% extends "layouts.master" %}
{% block content %}
    {# What the merchant composes in the editor — hero, sliders, banners, whatever they added #}
    {% component home %}

    {#
      Teraz structure. theme-raed leaves the entire homepage to the editor, which means a
      merchant who configures nothing ships a page that is just a product grid. These two
      sections are drawn by the theme instead, so the storefront is coherent from the first
      install; both have off switches and fully editable content in Theme Settings.
    #}
    {% include 'pages.partials.home.features' %}
    {% include 'pages.partials.home.lookbook' %}
{% endblock %}
{% block scripts %}
    <script defer src="{{ 'home.js' | asset }}"></script>
{% endblock %}